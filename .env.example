# ==============================================================================
# CyberGuard AI — Full Stack Environment Variables
# Copy to .env in your root directory or set individual service variables
# ==============================================================================

# --- Database ---
# For local MongoDB (via Docker Compose): mongodb://mongodb:27017/cyberguard
# For MongoDB Atlas: mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cyberguard
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/cyberguard

# --- Backend Configuration ---
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000
JWT_SECRET=your_super_secret_jwt_key_at_least_32_chars
JWT_EXPIRES_IN=7d

# --- Threat Intelligence APIs (Optional for Enhanced Realtime Scanning) ---
GOOGLE_SAFE_BROWSING_API_KEY=your_google_safe_browsing_api_key
VIRUSTOTAL_API_KEY=your_virustotal_api_key

# --- Frontend Configuration ---
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
